{
  "base": {
    "categorical": ["accent", "blue", "cyan", "green", "yellow", "orange", "red", "purple"],
    "text": {
      "base": "$hue.gray.100",
      "muted": "$hue.gray.400",
      "action": {
        "primary": {
          "base": "$hue.purple.400",
          "$hovered": "$hue.purple.300",
          "$focused": "$hue.purple.300",
          "$selected": "$hue.purple.300",
          "$pressed": "$hue.purple.500",
          "$disabled": "$hue.gray.600"
        },
        "secondary": {
          "base": "$hue.gray.200",
          "$hovered": "$hue.gray.100",
          "$focused": "$hue.gray.200",
          "$selected": "$hue.gray.200",
          "$pressed": "$hue.gray.300",
          "$disabled": "$hue.gray.600"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$hovered": "$hue.red.300",
          "$focused": "$hue.red.300",
          "$selected": "$hue.red.300",
          "$pressed": "$hue.red.500",
          "$disabled": "$hue.gray.600"
        }
      },
      "formfield": {
        "base": "$hue.gray.100",
        "$focused": "$hue.purple.300",
        "$disabled": "$hue.gray.500"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400",
          "muted": "$hue.red.300"
        },
        "warning": {
          "base": "$hue.yellow.400",
          "muted": "$hue.yellow.300"
        },
        "success": {
          "base": "$hue.green.400",
          "muted": "$hue.green.300"
        },
        "info": {
          "base": "$hue.cyan.400",
          "muted": "$hue.cyan.300"
        }
      }
    },
    "background": {
      "base": "$hue.gray.900",
      "raised": {
        "base": "$hue.gray.800",
        "high": "$hue.gray.700",
        "max": "$hue.gray.500"
      },
      "action": {
        "primary": {
          "base": "$hue.purple.500",
          "$hovered": "$hue.purple.600",
          "$focused": "$hue.purple.600",
          "$selected": "$hue.purple.500",
          "$pressed": "$hue.purple.700",
          "$disabled": "$hue.gray.700"
        },
        "secondary": {
          "base": "$background.raised.base",
          "$hovered": "$background.raised.high",
          "$focused": "$background.raised.high",
          "$selected": "$background.raised.base",
          "$pressed": "$background.raised.max",
          "$disabled": "$background.base"
        },
        "destructive": {
          "base": "$hue.red.500",
          "$hovered": "$hue.red.600",
          "$focused": "$hue.red.600",
          "$selected": "$hue.red.500",
          "$pressed": "$hue.red.700",
          "$disabled": "$hue.gray.700"
        }
      },
      "formfield": {
        "base": "$background.raised.base",
        "$focused": "$background.raised.high",
        "$disabled": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.900"
        },
        "warning": {
          "base": "$hue.yellow.900"
        },
        "success": {
          "base": "$hue.green.900"
        },
        "info": {
          "base": "$hue.cyan.900"
        }
      }
    },
    "border": {
      "base": "$hue.gray.600"
    },
    "scrollbar": {
      "base": "$hue.gray.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$text.muted",
        "hunkHeader": "$hue.gray.400"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$hue.gray.900"
      },
      "highlight": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300"
      },
      "lineNumber": {
        "text": "$hue.gray.400",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }
      }
    },
    "syntax": {
      "comment": "$hue.gray.500",
      "keyword": "$hue.purple.400",
      "function": "$hue.cyan.400",
      "variable": "$hue.gray.200",
      "string": "$hue.green.400",
      "number": "$hue.yellow.400",
      "type": "$hue.blue.400",
      "operator": "$hue.cyan.400",
      "punctuation": "$hue.gray.400"
    },
    "markdown": {
      "text": "$hue.gray.100",
      "heading": "$hue.purple.300",
      "link": "$hue.interactive.400",
      "linkText": "$hue.purple.400",
      "code": "$hue.purple.400",
      "blockQuote": "$hue.gray.400",
      "emphasis": "$hue.yellow.400",
      "strong": "$hue.purple.300",
      "horizontalRule": "$hue.gray.600",
      "listItem": "$hue.gray.100",
      "listEnumeration": "$hue.purple.400",
      "image": "$hue.blue.400",
      "imageText": "$hue.gray.400",
      "codeBlock": "$hue.gray.900"
    },
    "@dialog": {
      "text": {
        "action": {
          "primary": {
            "base": "$hue.gray.100"
          }
        }
      },
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "base": "$hue.purple.500",
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
