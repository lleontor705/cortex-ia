      },
      "accent": "$hue.purple",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    },
    "background": {
      "base": "#f8fafc",
      "raised": {
        "base": "#ffffff",
        "high": "#f1f5f9",
        "max": "#e2e8f0"
      }
    }
  }
}
