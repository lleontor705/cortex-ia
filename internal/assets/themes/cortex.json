        "900": "#881337"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    },
    "categorical": ["accent", "blue", "cyan", "purple", "green", "yellow", "orange"]
  }
}
