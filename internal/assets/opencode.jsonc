{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.agents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.cortex-ia/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/**/.agents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/**/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "**/.config/opencode/**", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "**/.credentials/**", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/Library/Keychains/**", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" }
  ],
  "share": "disabled"
}