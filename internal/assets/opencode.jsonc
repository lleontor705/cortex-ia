{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow",
      "**/.agents/skills/**": "allow",
      "C:/**/.agents/**": "allow",
      "C:/**/.agents/skills/**": "allow",
      "**/.config/opencode/**": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "list": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow",
      "**/.agents/skills/**": "allow",
      "C:/**/.agents/**": "allow"
    },
    "glob": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow",
      "**/.agents/skills/**": "allow",
      "C:/**/.agents/**": "allow"
    },
    "grep": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow",
      "**/.agents/skills/**": "allow",
      "C:/**/.agents/**": "allow"
    },
    "read": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow",
      "**/.agents/skills/**": "allow",
      "C:/**/.agents/**": "allow",
      "C:/**/.agents/skills/**": "allow",
      "**/.config/opencode/**": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.agents/**": "allow",
      "**/.agents/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "golangci-lint run *": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    }
  },
  "share": "disabled"
}