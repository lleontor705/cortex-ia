{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-5.6-sol"
    },
    "investigate": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "planner": {
      "model": "openai/gpt-5.6-sol"
    },
    "implement": {
      "model": "zai-coding-plan/glm-5.3"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol"
    }
  },
  "mcp": {
  "context7": {"command":["npx","-y","@upstash/context7-mcp"],"enabled":true,"type":"local"},
  "cortex": {"command":["cortex","mcp","--tools=agent"],"enabled":true,"type":"local"}},
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "share": "disabled"
}
