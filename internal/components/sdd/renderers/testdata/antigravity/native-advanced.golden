\": [\n    \"filesystem/read\",\n    \"filesystem/write\",\n    \"mcp/forgespec\"\n  ],\n  \"trust_classes\": [\n    \"repository_data\",\n    \"secret_reference\",\n    \"trusted_policy\"\n  ],\n  \"secret_handling\": \"opaque references only; secret values are never rendered\",\n  \"validation\": \"passed\"\n}\n"
