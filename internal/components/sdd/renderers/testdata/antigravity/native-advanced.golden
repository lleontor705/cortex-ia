    "content": "{\n  \"schema\": \"cortex-ia/antigravity-agent/v1\",\n  \"role\": {\n    \"id\": \"role/implement\",\n    \"objective\": \"Implement one bounded work unit with test evidence.\",\n    \"inputs\": [\n      {\n        \"id\": \"contract/task\",\n        \"schema_version\": \"1.0.0\",\n        \"required\": true\n      }\n    ],\n    \"outputs\": [\n      {\n        \"id\": \"contract/apply\",\n        \"schema_version\": \"1.0.0\",\n        \"required\": true\n      }\n    ],\n    \"non_goals\": [\n      \"coordinate unrelated tasks\"\n    ],\n    \"allowed_effects\": [\n      \"effect/read\",\n      \"effect/write\"\n    ],\n    \"evidence\": [\n      \"evidence/test\"\n    ],\n    \"terminal_states\": [\n      \"blocked\",\n      \"failed\",\n      \"success\"\n    ]\n  },\n  \"profile\": \"native-advanced\",\n  \"delegation\": [\n    \"delegation/direct-child\",\n    \"delegation/nested\"\n  ],\n  \"service_owners\": {\n    \"contracts_and_tasks\": \"ForgeSpec\",\n    \"dispatch_transport\": \"runtime-native\",\n    \"durable_memory\": \"Cortex\"\n  },\n  \"non_authority\": [\n    \"Antigravity runtime state is non-authoritative\",\n    \"generated agents do not replace external service ownership\"\n  ]\n}\n"
