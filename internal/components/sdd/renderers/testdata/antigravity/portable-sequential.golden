    "content": "{\n  \"schema\": \"cortex-ia/antigravity-semantic-manifest/v1\",\n  \"workflow_version\": \"1.0.0\",\n  \"generation_fingerprint\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"semantic_digest\": \"3c459b04add38724fe1999bc97ff8089d8e71a29f22bf1393027115a44d74fda\",\n  \"portable\": {\n    \"workflow_id\": \"workflow/software-change\",\n    \"roles\": [\n      {\n        \"id\": \"role/implement\",\n        \"objective\": \"Implement one bounded work unit with test evidence.\",\n        \"inputs\": [\n          {\n            \"id\": \"contract/task\",\n            \"schema_version\": \"1.0.0\",\n            \"required\": true\n          }\n        ],\n        \"outputs\": [\n          {\n            \"id\": \"contract/apply\",\n            \"schema_version\": \"1.0.0\",\n            \"required\": true\n          }\n        ],\n        \"non_goals\": [\n          \"coordinate unrelated tasks\"\n        ],\n        \"allowed_effects\": [\n          \"effect/read\",\n          \"effect/write\"\n        ],\n        \"evidence\": [\n          \"evidence/test\"\n        ],\n        \"terminal_states\": [\n          \"blocked\",\n          \"failed\",\n          \"success\"\n        ]\n      }\n    ],\n    \"phases\": [\n      {\n        \"id\": \"phase/apply\",\n        \"role\": \"role/implement\"\n      }\n    ],\n    \"tools\": [\n      {\n        \"id\": \"tool/filesystem\",\n        \"required\": true\n      }\n    ],\n    \"context_trust_classes\": [\n      \"repository_data\",\n      \"secret_reference\",\n      \"trusted_policy\"\n    ],\n    \"services\": [\n      {\n        \"id\": \"service/forgespec\",\n        \"version\": {\n          \"minimum\": \"1.0.0\",\n          \"maximum_tested\": \"1.0.0\"\n        }\n      }\n    ]\n  }\n}\n"
