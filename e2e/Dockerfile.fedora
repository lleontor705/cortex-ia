FROM golang:1.26.1-bookworm AS go-toolchain

FROM fedora:40

# Copy the exact local Go 1.26.1 toolchain from the pinned upstream stage; do
# not rely on Fedora's golang package, which may drift to an older patch.
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOTOOLCHAIN=local

RUN dnf install -y git curl nodejs npm && dnf clean all

WORKDIR /src
COPY . .
RUN go build -o /usr/local/bin/cortex-ia ./cmd/cortex-ia

RUN useradd -m testuser
USER testuser
ENV HOME=/home/testuser

ENTRYPOINT ["/bin/bash"]
